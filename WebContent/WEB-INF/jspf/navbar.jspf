<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<header>
  <nav class="navbar navbar-expand-sm bg-dark">
    <div class="container">
    <a class="navbar-brand" href="${pageContext.request.contextPath}/index.jsp" style="display:flex; align-items:center; gap:8px;">
      <i class="bi bi-book" style="font-size:1.5rem; color:#6366f1;"></i>
      <span style="color:#6366f1; font-weight:600;">BookStore</span>
    </a>
    <button style="background-color:white;" class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav">
        <li class="nav-item"><a class="nav-link ${activeTab == 'browse' ? 'active' : ''}" href="viewbook">Browse Books</a></li>
        <li class="nav-item"><a class="nav-link ${activeTab == 'home' ? 'active' : ''}" href="index.jsp">Home</a></li>
        <li class="nav-item"><a class="nav-link ${activeTab == 'login' ? 'active' : ''}" href="CustomerLogin.jsp">Login</a></li>
        <li class="nav-item"><a class="nav-link ${activeTab == 'register' ? 'active' : ''}" href="CustomerRegister.jsp">Register</a></li>
        <li class="nav-item"><a class="nav-link ${activeTab == 'about' ? 'active' : ''}" href="about">About Us</a></li>
      </ul>
    </div>
    </div>
  </nav>
</header>
